  <worksheets>
    <worksheet name='Avg Data Usage By Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontsize='12'>Avg Data Usage By Customers</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='customers+ (Task_02_cleaned_dataset)' name='federated.0g3624y0qly9f01fzl5xf0f8jij1' />
          </datasources>
          <datasource-dependencies datasource='federated.0g3624y0qly9f01fzl5xf0f8jij1'>
            <column caption='Customer Risk' datatype='string' name='[Calculation_0923336514281472]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [payment_status] &lt;&gt; &quot;Paid&quot; THEN&#13;&#10;    &quot;High Risk&quot;&#13;&#10;ELSEIF [resolution_time_hrs] &gt; 48 THEN&#13;&#10;    &quot;Medium Risk&quot;&#13;&#10;ELSEIF [Usage_status] = &quot;High Usage&quot; THEN&#13;&#10;    &quot;Medium Risk&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Risk&quot;&#13;&#10;END' />
            </column>
            <column caption='Usage status' datatype='string' name='[Usage_status]' role='dimension' type='nominal' />
            <column caption='Customer Type' datatype='string' name='[customer_type]' role='dimension' type='nominal' />
            <column caption='Data Used Gb' datatype='real' name='[data_used_gb]' role='measure' type='quantitative' />
            <column caption='Issue Type' datatype='string' name='[issue_type]' role='dimension' type='nominal' />
            <column-instance column='[customer_type]' derivation='None' name='[none:customer_type:nk]' pivot='key' type='nominal' />
            <column caption='Payment Status' datatype='string' name='[payment_status]' role='dimension' type='nominal' />
            <column caption='Resolution Time Hrs' datatype='integer' name='[resolution_time_hrs]' role='measure' type='quantitative' />
            <column-instance column='[data_used_gb]' derivation='Sum' name='[sum:data_used_gb:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0g3624y0qly9f01fzl5xf0f8jij1].[Action (Customer Risk)]'>
            <groupfilter function='member' level='[Calculation_0923336514281472]' member='&quot;Low Risk&quot;' user:ui-action-filter='[Action9_BFE4FD1DDA184F20AF86EDDCC829D210]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0g3624y0qly9f01fzl5xf0f8jij1].[Action (Issue Type)]'>
            <groupfilter function='member' level='[issue_type]' member='&quot;No Signal&quot;' user:ui-action-filter='[Action8_6C371DD31CEA4A49ADDA5529C8DD2851]' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.0g3624y0qly9f01fzl5xf0f8jij1].[Action (Issue Type)]</column>
